{
  "name": "me",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro sync && tsc --noEmit --runExternalCode",
    "lint": "biome check --formatter-enabled=false --error-on-warnings",
    "lint:fix": "biome check --formatter-enabled=false --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint:duplication": "jscpd",
    "lint:dead-code": "knip --no-progress --no-config-hints",
    "lint:secrets": "git ls-files -z | xargs -0 secretlint --no-glob",
    "lint:audit": "pnpm audit --audit-level high",
    "cleanup": "pnpm format && pnpm lint:fix && pnpm typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/ts-content-mapper": "0.2.0",
    "@biomejs/biome": "2.6.6",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "husky": "^9.1.7",
    "jscpd": "5.4.2",
    "knip": "6.44.2",
    "lint-staged": "^17.6.0",
    "secretlint": "13.1.0",
    "typescript": "7.1.0-beta"
  }
}
