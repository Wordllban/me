---
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Kostiantyn Mininkov — Software Engineer & Co-Founder",
  description = "Software engineer and co-founder of Ivy. I build thoughtful products end to end, increasingly with AI. Engineer and founder, gardener off the clock.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="generator" content={Astro.generator}>
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="icon" type="image/png" href="/assets/favicon.png">

    <Font
      cssVariable="--font-spectral"
      preload={[
        { weight: "400", style: "normal" },
        { weight: "600", style: "normal" },
      ]}
    />
    <Font cssVariable="--font-jetbrains-mono" />
  </head>
  <body
    style="background:var(--bg-grad);color:var(--text);font-family:var(--f-body)"
  >
    <slot />
  </body>
</html>
