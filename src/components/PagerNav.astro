---
// Mobile / tablet navigation: a "page-turner" bar (prev · current chapter · next)
// plus a jump-to-chapter bottom sheet. Hidden on desktop via CSS ([data-bottomnav]).
import { uprightLeaves } from "../data/ivy";
import { sectionMeta } from "../data/portfolio";
import IvyLeaf from "./IvyLeaf.astro";

const activeKey = "about";
const cur = sectionMeta.find((m) => m.key === activeKey) ?? sectionMeta[0];
const rowTilt = [4, -6, 8, -4, 6, -8, 2];
const arrow = "M9.5 5 L16.5 12 L9.5 19";
---

<!-- page-turner nav -->
<nav
  data-bottomnav
  aria-label="Browse sections"
  class="tt"
  style="position:relative;z-index:30;align-items:center;gap:10px;padding:8px 14px max(8px,env(safe-area-inset-bottom));background:linear-gradient(180deg,rgba(15,10,24,.94),rgba(8,5,13,.99));box-shadow:0 -1px 0 rgba(176,138,86,.32),0 -18px 30px -18px rgba(0,0,0,.8);flex:0 0 auto"
>
  <button
    type="button"
    data-pager-prev
    class="pager-btn"
    aria-label="Previous section"
  >
    <span class="pager-ring pager-ring-back"></span>
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      width="21"
      height="21"
      fill="none"
      class="pager-arrow pager-arrow-back"
    >
      <path
        d={arrow}
        stroke="var(--gold)"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
      <circle cx="16.5" cy="12" r="1.4" fill="var(--gold)"></circle>
    </svg>
  </button>

  <button
    type="button"
    data-pager-toggle
    aria-label="Jump to section"
    style="position:relative;flex:1 1 auto;min-width:0;display:flex;flex-direction:column;align-items:center;gap:8px;padding:4px 8px;border:none;background:transparent;cursor:pointer;color:inherit;-webkit-tap-highlight-color:transparent"
  >
    <span
      style="display:flex;align-items:center;gap:9px;width:100%;justify-content:center"
    >
      <span
        style="flex:1 1 0;height:1px;max-width:32px;background:linear-gradient(90deg,transparent,rgba(150,90,255,.45))"
      ></span>
      <span
        data-pager-numeral
        style="display:inline-grid;place-items:center;width:23px;height:23px;flex:0 0 auto;font-family:var(--f-display);font-size:11px;color:var(--gold);border:1px solid rgba(216,180,106,.4);border-radius:50%;letter-spacing:.02em;background:rgba(216,180,106,.06)"
      >
        {cur.n}
      </span>
      <span
        data-pager-label
        style="font-family:var(--f-display);font-size:16px;letter-spacing:.03em;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0"
      >
        {cur.label}
      </span>
      <span
        style="flex:1 1 0;height:1px;max-width:32px;background:linear-gradient(90deg,rgba(150,90,255,.45),transparent)"
      ></span>
    </span>
    <span style="display:flex;align-items:center;gap:5px">
      {sectionMeta.map((m) => (
        <span
          class="pager-dot"
          data-pager-dot={m.key}
          data-active={m.key === activeKey ? "" : undefined}
        />
      ))}
    </span>
  </button>

  <button
    type="button"
    data-pager-next
    class="pager-btn"
    aria-label="Next section"
  >
    <span class="pager-ring"></span>
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      width="21"
      height="21"
      fill="none"
      class="pager-arrow"
    >
      <path
        d={arrow}
        stroke="var(--gold)"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
      <circle cx="16.5" cy="12" r="1.4" fill="var(--gold)"></circle>
    </svg>
  </button>
</nav>

<!-- jump-to-chapter bottom sheet -->
<div data-nav-sheet class="nav-sheet">
  <div
    data-nav-panel
    style="position:relative;background:linear-gradient(180deg,rgba(36,25,56,.82),rgba(22,15,34,.9));border-top:1px solid rgba(150,90,255,.42);border-radius:20px 20px 0 0;padding:10px 14px max(18px,env(safe-area-inset-bottom));box-shadow:inset 0 1px 0 rgba(255,255,255,.06),0 -18px 50px -20px #000;max-height:74vh;overflow-y:auto"
  >
    <div
      style="display:flex;align-items:center;justify-content:space-between;padding:8px 12px 12px"
    >
      <span
        style="font-family:var(--f-mono);font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold)"
      >
        Jump to section
      </span>
      <button
        type="button"
        data-nav-close
        aria-label="Close"
        style="width:32px;height:32px;display:grid;place-items:center;border-radius:9px;border:1px solid rgba(176,138,86,.36);background:rgba(255,255,255,.03);cursor:pointer"
      >
        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
          <path
            d="M2 2 L10 10 M10 2 L2 10"
            fill="none"
            stroke="var(--text-dim)"
            stroke-width="1.4"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>
    {sectionMeta.map((m, i) => (
      <button
        type="button"
        class="nav-row"
        data-nav-row={m.key}
        data-active={m.key === activeKey ? "" : undefined}
      >
        <span class="nav-row-n">{m.n}</span>
        <IvyLeaf
          variant={uprightLeaves[i % uprightLeaves.length]}
          size={30}
          length={20}
          rotate={rowTilt[i % rowTilt.length]}
          class="nav-row-leaf"
        />
        <span style="display:flex;flex-direction:column;gap:3px;min-width:0">
          <span class="nav-row-label">{m.label}</span>
          <span class="nav-row-desc">{m.desc}</span>
        </span>
      </button>
    ))}
  </div>
</div>
