---
import { accolades, course, education, wins } from "../../data/portfolio";
import IvyLeaf from "../IvyLeaf.astro";
import SectionHeader from "./SectionHeader.astro";
---

<div class="section" data-section="wins">
  <SectionHeader
    title="Little wins, shared out loud."
    rune="05 · Background"
    marginBottom="6px"
  />
  <p
    data-wins-intro
    style="color:var(--text-dim);margin:0 0 18px;flex:0 0 auto;white-space:nowrap"
  >
    Education, credentials and milestones.
  </p>
  <div
    data-body
    style="flex:1;min-height:0;overflow-y:auto;padding-right:6px;display:flex;flex-direction:column;gap:18px"
  >
    <!-- The Academy -->
    <div style="display:flex;align-items:center;gap:10px">
      <IvyLeaf variant="u5" size={20} length={15} />
      <span
        style="font-family:var(--f-mono);font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold)"
      >
        Education · degrees &amp; courses
      </span>
      <span class="label-rule"></span>
    </div>

    <!-- university tome -->
    <article
      style="position:relative;padding:clamp(18px,2.2vw,26px)"
      class="card-edge card-feature tt"
    >
      <span class="corner tl"></span>
      <span class="corner br"></span>
      <div
        style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:16px;flex-wrap:wrap"
      >
        <div style="display:flex;align-items:flex-start;gap:13px;min-width:0">
          <IvyLeaf
            variant="u1"
            size={30}
            length={22}
            glow
            style="margin-top:-2px"
          />
          <div style="min-width:0">
            <div
              style="font-family:var(--f-mono);font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent-2);margin-bottom:5px"
            >
              {education.degree}
            </div>
            <h3
              style="font-family:var(--f-display);font-size:clamp(18px,2vw,22px);margin:0 0 4px;line-height:1.15"
            >
              {education.field}
            </h3>
            <div style="color:var(--text-dim);font-size:14px">
              {education.school}
            </div>
          </div>
        </div>
        <div
          style="flex:0 0 auto;display:flex;flex-direction:column;align-items:center;gap:3px;padding:9px 16px;border-radius:var(--radius);border:1px solid var(--border-2);background:linear-gradient(180deg,rgba(124,77,255,.14),transparent)"
        >
          <span
            style="font-family:var(--f-mono);font-size:8.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--text-faint)"
          >
            Grade
          </span>
          <span
            style="font-family:var(--f-display);font-weight:600;font-size:20px;color:var(--text);line-height:1"
          >
            {education.grade}
          </span>
        </div>
      </div>
      <div
        style="font-family:var(--f-mono);font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--text-faint);margin-bottom:9px"
      >
        Key coursework
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:7px">
        {education.courses.map((c) => (
          <span style="font-family:var(--f-mono);font-size:11px;padding:5px 11px;border-radius:999px;background:var(--chip-bg);border:1px solid var(--border);color:var(--text-dim)">
            {c}
          </span>
        ))}
      </div>
    </article>

    <!-- accelerator victories -->
    <div
      data-accolades-grid
      style="display:grid;grid-template-columns:repeat(2,1fr);gap:14px"
    >
      {accolades.map((a) => (
        <article
          class="card-edge tt"
          style="position:relative;display:flex;align-items:center;gap:14px;padding:16px 18px"
        >
          <span style="flex:0 0 auto;width:38px;height:38px;display:grid;place-items:center;border-radius:var(--radius);border:1px solid rgba(216,180,106,.36);background:radial-gradient(circle at 50% 35%,rgba(216,180,106,.16),rgba(216,180,106,.04) 70%)">
            <span class="kind-diamond" style="width:9px;height:9px" />
          </span>
          <div style="min-width:0;flex:1">
            <div style="font-family:var(--f-mono);font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);margin-bottom:4px">
              {a.kind}
            </div>
            <div style="font-family:var(--f-display);font-size:17px;line-height:1.15;color:var(--text)">
              {a.title}
            </div>
          </div>
          <span style="flex:0 0 auto;font-family:var(--f-mono);font-size:12px;color:var(--accent-2)">
            {a.year}
          </span>
        </article>
      ))}
    </div>

    <!-- course -->
    <article class="card-edge tt" style="position:relative;padding:18px 20px">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:9px">
        <span class="kind-diamond"></span>
        <span
          style="font-family:var(--f-mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--gold)"
        >
          {course.kind}
        </span>
      </div>
      <h3
        style="font-family:var(--f-display);font-size:19px;margin:0 0 9px;line-height:1.25"
      >
        {course.title}
      </h3>
      <p
        style="color:var(--text-dim);font-size:14px;margin:0;line-height:1.66;max-width:74ch"
      >
        {course.note}
      </p>
    </article>

    <!-- Milestones -->
    <div style="display:flex;align-items:center;gap:10px;margin-top:4px">
      <IvyLeaf variant="u3" size={20} length={15} />
      <span
        style="font-family:var(--f-mono);font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold)"
      >
        Milestones
      </span>
      <span class="label-rule"></span>
    </div>

    {wins.map((w) => (
      <article
        class="tt"
        style="display:grid;grid-template-columns:auto 1fr;gap:20px;align-items:center;border-top:1px solid rgba(176,138,86,.22);padding:14px 4px 0"
      >
        <div style="font-family:var(--f-mono);font-size:10.5px;letter-spacing:.1em;color:var(--accent);text-align:left;min-width:76px">
          {w.date}
        </div>
        <div>
          <div style="font-family:var(--f-display);font-size:17px;line-height:1.2">
            {w.title}
          </div>
          <div style="color:var(--text-dim);font-size:14px;line-height:1.6">
            {w.note}
          </div>
        </div>
      </article>
    ))}
  </div>
</div>
