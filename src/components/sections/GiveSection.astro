---
import { giving } from "../../data/portfolio";
import SectionHeader from "./SectionHeader.astro";
---

<div class="section" data-section="give">
  <SectionHeader
    title="Talks, open source & care."
    rune="04 · Community"
    marginBottom="20px"
  />
  <div
    data-body
    data-give-grid
    style="flex:1;min-height:0;overflow-y:auto;padding-right:6px;display:grid;grid-template-columns:repeat(3,1fr);gap:16px;align-content:start"
  >
    {giving.map((g) => (
      <article
        class="card-edge card-lift tt"
        style="position:relative;padding:22px"
      >
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px">
          <span class="kind-diamond" />
          <span style="font-family:var(--f-mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--gold)">
            {g.kind}
          </span>
          <span class="label-rule" />
        </div>
        <h3 style="font-family:var(--f-display);font-size:19px;margin:0 0 9px;line-height:1.25">
          {g.title}
        </h3>
        <p style="color:var(--text-dim);font-size:14px;margin:0;line-height:1.66">
          {g.note}
        </p>
        {g.href && (
          <>
            <span
              class="link-chip"
              style="position:absolute;top:14px;right:14px"
            >
              ↗
            </span>
            <!-- biome-ignore lint/a11y/useAnchorContent: aria-label is an Astro expression Biome cannot read -->
            <a
              class="give-card-link"
              href={g.href}
              target="_blank"
              rel="noopener"
              aria-label={g.title}
              style="position:absolute;inset:0;border-radius:var(--radius)"
            />
          </>
        )}
      </article>
    ))}
  </div>
</div>
