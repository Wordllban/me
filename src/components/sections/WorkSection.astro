---
import { projects } from "../../data/portfolio";
import IvyLeaf from "../IvyLeaf.astro";
import SectionHeader from "./SectionHeader.astro";
---

<div class="section" data-section="work">
  <SectionHeader
    title="Things I've planted."
    rune="03 · Work"
    marginBottom="20px"
  />
  <div
    data-body
    style="flex:1;min-height:0;overflow-y:auto;padding-right:6px;display:flex;flex-direction:column;gap:16px"
  >
    <article
      style="position:relative;padding:clamp(20px,2.6vw,30px)"
      class="card-edge card-feature tt"
    >
      <span class="corner tl"></span>
      <span class="corner br"></span>
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px">
        <IvyLeaf variant="u2" size={28} length={21} glow />
        <span style="font-family:var(--f-display);font-size:22px">Ivy</span>
        <span
          style="font-family:var(--f-mono);font-size:10.5px;padding:4px 9px;border-radius:999px;background:var(--accent);color:#140b1c;font-weight:600"
        >
          CO-FOUNDER
        </span>
      </div>
      <p
        style="color:var(--text-dim);margin:0 0 14px;line-height:1.66;max-width:62ch"
      >
        My startup — a freelance, commission &amp; community platform for every
        form of art, giving clients and artists every tool to find each other
        and work together in one place. Open beta arrives this summer.
      </p>
      <a
        href="https://ivyart.co/"
        target="_blank"
        rel="noopener"
        style="font-family:var(--f-mono);font-size:12.5px;color:var(--accent-2);text-decoration:none"
      >
        join the open beta →
      </a>
    </article>
    <div
      data-work-grid
      style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px"
    >
      {projects.map((p) => (
        <article
          class="work-card card-edge card-lift tt"
          style="position:relative;padding:18px;display:flex;flex-direction:column;gap:8px"
        >
          <div style="display:flex;align-items:center;gap:10px">
            <span class="kind-diamond" />
            <span style="font-family:var(--f-mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--gold)">
              {p.tag}
            </span>
            <span class="label-rule" />
          </div>
          <h3 style="font-family:var(--f-display);font-size:18px;margin:0">
            {p.name}
          </h3>
          <p style="color:var(--text-dim);font-size:13px;margin:0;line-height:1.55">
            {p.note}
          </p>
          {p.href && (
            <>
              <span style="font-family:var(--f-mono);font-size:11px;color:var(--accent-2);margin-top:2px">
                open repo ↗
              </span>
              <!-- biome-ignore lint/a11y/useAnchorContent: aria-label is an Astro expression Biome cannot read -->
              <a
                href={p.href}
                target="_blank"
                rel="noopener"
                aria-label={p.name}
                style="position:absolute;inset:0;border-radius:var(--radius)"
              />
            </>
          )}
        </article>
      ))}
    </div>
  </div>
</div>
