---
// Compact top bar: shown only on mobile/tablet (hidden on desktop, where the
// identity block lives in the rail instead). Sigil is still a clickable easter egg.
---

<header
  data-topbar
  style="position:relative;z-index:20;display:none;align-items:center;gap:11px;padding:11px clamp(15px,3.5vw,24px);flex:0 0 auto"
  class="tt"
>
  <div
    style="display:flex;align-items:center;gap:13px;font-weight:600;letter-spacing:.02em"
  >
    <span data-logo-click title="Ivy" class="logo-sigil">
      <span class="logo-halo"></span>
      <img src="/assets/ivy-logo.webp" alt="Ivy" class="logo-img logo-img-sm">
    </span>
    <span
      data-brandname
      style="font-family:var(--f-mono);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--text-dim)"
    >
      Kostiantyn&nbsp;Mininkov
    </span>
  </div>
  <span
    aria-hidden="true"
    style="position:absolute;left:clamp(15px,3.5vw,24px);right:clamp(15px,3.5vw,24px);bottom:0;height:1px;background:linear-gradient(90deg,rgba(176,138,86,0),rgba(176,138,86,.32) 20%,rgba(150,90,255,.24) 80%,rgba(150,90,255,0))"
  ></span>
</header>
