---
// Compact top bar: shown only on mobile/tablet (hidden on desktop, where the
// identity block lives in the rail instead). Sigil is still a clickable easter egg.
---

<header
  data-topbar
  style="position:relative;z-index:20;display:none;align-items:center;gap:11px;padding:11px clamp(15px,3.5vw,24px);flex:0 0 auto"
  class="tt"
>
  <div style="display:flex;align-items:center;gap:13px;font-weight:600;letter-spacing:.02em">
    <span
      data-logo-click
      title="Ivy"
      style="position:relative;display:inline-grid;place-items:center;width:38px;height:38px;cursor:pointer"
    >
      <span style="position:absolute;inset:-5px;border-radius:50%;background:radial-gradient(circle,rgba(168,92,255,.5),transparent 68%);animation:haze 3.4s ease-in-out infinite"></span>
      <img
        src="/assets/ivy-logo.png"
        alt="Ivy"
        style="position:relative;width:22px;height:22px;border-radius:6px;opacity:.9"
      />
    </span>
    <span
      data-brandname
      style="font-family:var(--f-mono);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--text-dim)"
    >
      Kostiantyn&nbsp;Mininkov
    </span>
  </div>
</header>
