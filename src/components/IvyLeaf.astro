---
// One real ivy leaf as a decorative icon, centred in a square box.

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { type IvyVariant, ivyLeaves, ivyPath, ivyScale } from "../data/ivy";

interface Props {
  variant: IvyVariant;
  /** box size in px */
  size: number;
  /** terminal lobe length in px */
  length: number;
  rotate?: number;
  glow?: boolean;
  class?: string;
  style?: string;
}

const {
  variant,
  size,
  length,
  rotate = 0,
  glow = false,
  class: className,
  style = "",
} = Astro.props;
const leaf = ivyLeaves[variant];
const width = Math.round(leaf.w * ivyScale(variant, length) * 10) / 10;
const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/ivy/*.webp",
  { eager: true }
);
const image = images[ivyPath(variant)]?.default;
if (!image) throw new Error(`Missing ivy leaf image: ${variant}`);
---

<span
  class:list={["ivy-icon", className]}
  data-glow={glow ? "" : undefined}
  style={`--size:${size}px;--rot:${rotate}deg;${style}`}
  aria-hidden="true"
>
  <Image
    src={image}
    alt=""
    width={Math.ceil(width)}
    densities={[1, 2]}
    loading="eager"
    decoding="async"
    style={`width:${width}px`}
  />
</span>
