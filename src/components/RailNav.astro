---
import { ivyLeaves, ivyScale, ivySrc } from "../data/ivy";
import { sectionMeta } from "../data/portfolio";

const activeKey = "about";

// One real ivy leaf per chapter: its tilt, relative size and where its petiole
// meets the row. The vine script grows the stem to these junctions.
const rowLeaves = [
  { variant: "c1", rotate: 6, size: 1, dx: -3, dy: -6 },
  { variant: "c2", rotate: -22, size: 1.03, dx: 6, dy: -5 },
  { variant: "c3", rotate: 28, size: 0.94, dx: -5, dy: -4 },
  { variant: "c4", rotate: -18, size: 1.06, dx: 3, dy: -8 },
  { variant: "c5", rotate: 22, size: 0.97, dx: 5, dy: -5 },
  { variant: "c6", rotate: -26, size: 1, dx: -3, dy: -7 },
  { variant: "c7", rotate: 14, size: 1.09, dx: 5, dy: -4 },
] as const;

const rows = sectionMeta.map((it, i) => {
  const spec = rowLeaves[i % rowLeaves.length];
  const leaf = ivyLeaves[spec.variant];
  const perLength = ivyScale(spec.variant, 1);
  return {
    ...it,
    active: it.key === activeKey,
    src: ivySrc(spec.variant),
    leaf,
    perLength: leaf.w * perLength,
    petiole: leaf.pa + spec.rotate,
    style: [
      `--w:${(leaf.w * perLength).toFixed(4)}`,
      `--jx:${(leaf.jx * perLength).toFixed(4)}`,
      `--jy:${(leaf.jy * perLength).toFixed(4)}`,
      `--rot:${spec.rotate}deg`,
      `--size:${spec.size}`,
      `--dx:${spec.dx}px`,
      `--dy:${spec.dy}px`,
    ].join(";"),
  };
});
---

<aside data-rail class="rail tt">
  <span class="rail-edge" aria-hidden="true"></span>
  <svg data-vine class="rail-vine" aria-hidden="true">
    <defs>
      <linearGradient
        id="ivy-bark"
        gradientUnits="userSpaceOnUse"
        x1="0"
        x2="0"
      >
        <stop offset="0" stop-color="#4a3c2c"></stop>
        <stop offset="0.4" stop-color="#4b4a2d"></stop>
        <stop offset="0.75" stop-color="#4f6a33"></stop>
        <stop offset="1" stop-color="#78a64e"></stop>
      </linearGradient>
      <linearGradient id="ivy-lit" gradientUnits="userSpaceOnUse" x1="0" x2="0">
        <stop offset="0" stop-color="#6e5d45"></stop>
        <stop offset="0.4" stop-color="#6c6a40"></stop>
        <stop offset="0.75" stop-color="#6e9147"></stop>
        <stop offset="1" stop-color="#9fcb6c"></stop>
      </linearGradient>
      <linearGradient id="ivy-hi" gradientUnits="userSpaceOnUse" x1="0" x2="0">
        <stop offset="0" stop-color="#a8977a"></stop>
        <stop offset="0.5" stop-color="#a3a578"></stop>
        <stop offset="1" stop-color="#c9e6a0"></stop>
      </linearGradient>
      <linearGradient id="ivy-pr" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#6d4f5c"></stop>
        <stop offset="0.35" stop-color="#7b6c4c"></stop>
        <stop offset="1" stop-color="#8aa85a"></stop>
      </linearGradient>
      <linearGradient id="ivy-pl" x1="1" y1="0" x2="0" y2="0">
        <stop offset="0" stop-color="#6d4f5c"></stop>
        <stop offset="0.35" stop-color="#7b6c4c"></stop>
        <stop offset="1" stop-color="#8aa85a"></stop>
      </linearGradient>
    </defs>
    <g data-vine-body></g>
  </svg>

  <div class="rail-head">
    <span data-logo-click title="Ivy" class="logo-sigil">
      <span class="logo-halo"></span>
      <img
        data-medallion
        data-logo-leaf
        src="/assets/ivy-logo.webp"
        alt="Ivy"
        class="logo-img"
      >
    </span>
    <span
      style="font-family:var(--f-display);font-size:19px;letter-spacing:.04em;font-weight:600"
    >
      Kostiantyn&nbsp;Mininkov
    </span>
  </div>

  <div class="rail-intro" data-rail-intro>
    <div
      style="font-family:var(--f-mono);font-size:10px;letter-spacing:.24em;text-transform:uppercase;color:var(--gold);margin-bottom:11px"
    >
      Software Engineer · Co-Founder
    </div>
    <p style="color:var(--text-dim);font-size:14.5px;line-height:1.58;margin:0">
      I build thoughtful products end to end — fullstack, increasingly with AI.
      Six years in, I care most about shipping things that genuinely help people
      — and I co-founded Ivy, a platform for artists and the people who
      commission them.
    </p>
  </div>

  <nav aria-label="Sections" class="rail-nav">
    {rows.map((it) => (
      <button
        type="button"
        class="nav-item"
        data-nav={it.key}
        data-active={it.active ? "" : undefined}
      >
        <span class="nav-dagger-outline" />
        <span class="nav-dagger-fill" />
        <span class="nav-tip">
          <svg
            aria-hidden="true"
            viewBox="0 0 17 100"
            preserveAspectRatio="none"
            style="display:block;width:100%;height:100%;overflow:visible"
          >
            <path
              d="M0 0.8 L16.2 50 L0 99.2"
              fill="none"
              stroke="rgba(216,180,106,.95)"
              stroke-width="1.3"
              vector-effect="non-scaling-stroke"
            />
          </svg>
        </span>
        <span class="nav-leaf-wrap" data-leaf style={it.style}>
          <span class="nav-leaf-glow" />
          <img
            class="nav-leaf"
            src={it.src}
            alt=""
            width={it.leaf.w}
            height={it.leaf.h}
            decoding="async"
          >
          <span
            class="nav-leaf-junction"
            data-junction
            data-petiole={it.petiole}
            data-image-per-length={it.perLength.toFixed(4)}
          />
        </span>
        <span style="position:relative;z-index:1;display:flex;flex-direction:column;line-height:1.08;min-width:0">
          <span class="nav-label">
            <span class="nav-num">{it.n}</span>
            {it.label}
          </span>
          <span style="font-family:var(--f-mono);font-size:11px;color:var(--text-faint);letter-spacing:.02em;white-space:nowrap">
            {it.desc}
          </span>
        </span>
      </button>
    ))}
  </nav>

  <div class="rail-foot">
    <a
      href="https://github.com/Wordllban"
      target="_blank"
      rel="noopener"
      style="text-decoration:none"
    >
      github
    </a>
    <a
      href="https://www.linkedin.com/in/kostiantyn-mininkov/"
      target="_blank"
      rel="noopener"
      style="text-decoration:none"
    >
      linkedin
    </a>
    <a href="mailto:mininkov1337@gmail.com" style="text-decoration:none">
      email
    </a>
    <span style="margin-left:auto;opacity:.7">↑↓ / click</span>
  </div>
</aside>
