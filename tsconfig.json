{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "portfolio-website-design-concepts", "claude-design"],
  "compilerOptions": {
    "strictNullChecks": true,
    "verbatimModuleSyntax": true
  },
  "contentMappers": [
    {
      "package": "@astrojs/ts-content-mapper",
      "extensions": [".astro"]
    }
  ]
}
